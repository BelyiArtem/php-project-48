{
    "name": "hexlet/code",
    "type": "project",
    "description": "gendiff application",
    "license": "MIT",
    "scripts": {
        "test": "phpunit tests"
    },
    "autoload": {
        "files": [
            "src/Differ.php",
            "src/Parsers.php",
            "src/TreeBuilder.php",
            "src/Formats.php",
            "src/Formatters/Stylish.php",
            "src/Formatters/Plain.php",
            "src/Formatters/Json.php"
        ]
    },
    "bin": [
        "bin/gendiff"
    ],
    "authors": [
        {
            "name": "Артём Белый",
            "email": "arcmadcan@yandex.ru"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BelyiArtem/funct"
        }
    ],
    "require": {
        "docopt/docopt": "^1.0",
        "symfony/yaml": "^7.3",
        "funct/funct": "dev-master@dev"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^13.2",
        "symfony/var-dumper": "^8.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
