{
    "name": "hexlet/code",
    "type": "project",
    "description": "gendiff application",
    "license": "MIT",
    "scripts": {
        "test": "phpunit tests"
    },
    "autoload": {
        "files": [
            "src/Differ.php",
            "src/Parser.php",
            "src/TreeBuilder.php",
            "src/Formatter/Stylish.php",
            "src/Formatter/Plain.php",
            "src/Formatter/Json.php",
            "src/Formatter/Format.php"
        ],
        "psr-4": {
            "Differ\\Differ\\": "src/"
        }
    },
    "bin": [
        "bin/gendiff"
    ],
    "authors": [
        {
            "name": "Артём Белый",
            "email": "arcmadcan@yandex.ru"
        }
    ],
    "require": {
        "docopt/docopt": "^1.0",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^13.2",
        "symfony/var-dumper": "^8.1"
    }
}
